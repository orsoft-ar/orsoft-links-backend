# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orsoft_links

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (lista de origenes separados por coma; vacio = permitir todos en desarrollo)
CORS_ORIGINS=https://orsoft.site,http://localhost:4200

# Bcrypt
BCRYPT_SALT_ROUNDS=10