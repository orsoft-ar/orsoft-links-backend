# Server
PORT=3000

# PostgreSQL
# Opcion A: connection string unico (ej: Neon / Supabase). Si se define,
# ignora DB_HOST/DB_PORT/etc. y habilita SSL automaticamente.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Opcion B: variables sueltas (Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orsoft_links
# Solo si usas Opcion B y el host exige TLS
# DB_SSL=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (lista de origenes separados por coma; vacio = permitir todos en desarrollo)
CORS_ORIGINS=https://orsoft.site,http://localhost:4200

# Bcrypt
BCRYPT_SALT_ROUNDS=10
# URL publica del frontend (para sitemap)
FRONTEND_URL=https://linkorsoft.site
